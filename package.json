{
  "name": "blood-connect-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "BloodConnect — Commercial Windows Desktop Application for Blood Banks",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@blood-connect/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "package:win": "npm run package:win --workspace=@blood-connect/desktop",
    "clean": "node -e \"const fs=require('fs'); ['dist','dist-installer','.vite'].forEach(d=>{fs.rmSync('apps/desktop/'+d,{recursive:true,force:true})})\""
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}

