{
  "name": "@blood-connect/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "BloodConnect Commercial Windows Desktop Client",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "esbuild src/main/main.ts --bundle --platform=node --target=node20 --outfile=dist/main/main.js --external:electron",
    "build:preload": "esbuild src/preload/preload.ts --bundle --platform=node --target=node20 --outfile=dist/preload/preload.js --external:electron",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "typecheck": "tsc --noEmit",
    "package:win": "npm run build && electron-builder --win nsis",
    "pack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@blood-connect/shared": "*",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@blood-connect/config": "*",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}

