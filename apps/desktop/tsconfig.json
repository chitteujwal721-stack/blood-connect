{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@blood-connect/config/tsconfig.react.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@blood-connect/shared": ["../../packages/shared/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": [
    "src/renderer/**/*",
    "src/preload/**/*",
    "src/main/**/*",
    "vite.config.ts"
  ]
}

