# ==============================================================================
# BloodConnect — Environment Variables Example
# Phase 1: Desktop Foundation
# ==============================================================================

# Application Environment
NODE_ENV=development

# Central API URL (Scheduled for Phase 2 integration - NestJS)
# DO NOT store production secrets or credentials in this file.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Desktop Client Window Configuration
BLOODCONNECT_DEV_PORT=5173
BLOODCONNECT_ENABLE_DEVTOOLS=true

